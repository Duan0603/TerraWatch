# =============================================================================
# AI Inference Service - Local Environment Configuration
# Sao chép file này thành .env: cp .env.example .env
# =============================================================================

PORT=8001
HOST=0.0.0.0

# Kết nối Redis Message Broker (nhận sự kiện phân tích ảnh tự động)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_EVENT_CHANNEL=terrawatch:events

# Đường dẫn file trọng số mô hình ONNX
ONNX_MODEL_PATH=models/landslide_deeplabv3plus.onnx
