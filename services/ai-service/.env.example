# =============================================================================
# AI Inference Service - Local Environment Configuration
# Sao chép file này thành .env: cp .env.example .env
# =============================================================================

PORT=8001
HOST=0.0.0.0

# Kết nối Redis Message Broker (nhận sự kiện phân tích ảnh tự động)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_EVENT_CHANNEL=terrawatch:events

# Mô hình v1.0 (file lấy từ TerraWatch_AI/models/l4s_tilenorm_v1/, không commit file .onnx)
ONNX_MODEL_PATH=models/deeplabv3plus_r50_l4s_tilenorm.onnx
MODEL_CARD_PATH=models/model_card.json
# Thư mục chứa ảnh GeoTIFF của cảnh (chỉ nhận tên file trong thư mục này)
SCENE_DIR=scenes
