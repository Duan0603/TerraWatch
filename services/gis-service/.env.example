# =============================================================================
# GIS Pipeline & Data Service - Local Environment Configuration
# Sao chép file này thành .env: cp .env.example .env
# =============================================================================

PORT=8002
HOST=0.0.0.0

# Kết nối cơ sở dữ liệu địa không gian PostGIS 15
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/terrawatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=terrawatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Khóa API viễn thám vệ tinh bên ngoài
NASA_FIRMS_MAP_KEY=placeholder_nasa_firms_key
SENTINEL_HUB_CLIENT_ID=placeholder_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=placeholder_sentinel_client_secret
