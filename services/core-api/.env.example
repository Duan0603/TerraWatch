# =============================================================================
# Core API Service (Spring Boot 3) - Local Environment Configuration
# Sao chép file này thành .env: cp .env.example .env
# (Có thể nạp qua plugin EnvFile trên IntelliJ hoặc envFile trong .vscode/launch.json)
# =============================================================================

SERVER_PORT=3000

# Cấu hình CSDL PostGIS
DATABASE_URL=jdbc:postgresql://localhost:5432/terrawatch?currentSchema=core_schema,gis_schema,public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=terrawatch

# Cấu hình Redis Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379

# Khóa JWT Authentication
JWT_SECRET=terrawatch_super_secret_jwt_key_for_capstone_project_2026_se_defense
JWT_EXPIRATION_MS=86400000

# URL gọi liên Microservices nội bộ
AI_SERVICE_URL=http://localhost:8001
GIS_SERVICE_URL=http://localhost:8002
