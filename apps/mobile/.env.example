# =============================================================================
# Mobile Citizen App (Flutter) - Local Environment Configuration
# Sao chép file này thành .env: cp .env.example .env
# =============================================================================

# Địa chỉ API Gateway Nginx:
# - Máy ảo Android Emulator: http://10.0.2.2:8080
# - Máy ảo iOS Simulator:    http://localhost:8080
# - Điện thoại thật (WiFi LAN): http://<IP_MÁY_TÍNH_CỦA_BẠN>:8080
API_BASE_URL=http://10.0.2.2:8080

# Khóa hiển thị bản đồ số Mapbox
MAPBOX_ACCESS_TOKEN=pk.placeholder_mapbox_token
