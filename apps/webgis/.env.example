# =============================================================================
# WebGIS Dashboard - Local Environment Configuration
# Sao chép file này thành .env hoặc .env.local: cp .env.example .env
# =============================================================================

# Cổng khởi chạy Vite Dev Server
VITE_PORT=5173

# Địa chỉ API Gateway Nginx (hoặc Core API trực tiếp)
VITE_API_BASE_URL=http://localhost:8080

# Khóa MapTiler Cloud cho nền bản đồ + DEM 3D Terrain (đăng ký miễn phí tại maptiler.com/cloud)
# Để trống thì ứng dụng tự dùng OpenFreeMap + Terrarium DEM (zero-config, không cần key)
VITE_MAPTILER_KEY=

# Firebase web app của dự án terrawatch-ac26f (Firebase console > Project settings > Your apps > Web app).
# Dùng cho xác thực số điện thoại khi đăng ký công dân. Để trống thì web báo "chưa cấu hình", không gửi OTP.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=terrawatch-ac26f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=terrawatch-ac26f
VITE_FIREBASE_STORAGE_BUCKET=terrawatch-ac26f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nút 'Diễn tập nhanh' (điền sẵn tài khoản demo) chỉ hiện khi chạy npm run dev. Muốn có nó trong bản build/Docker
# để tập dượt bảo vệ, đặt true; bản chạy thật phải để trống (mật khẩu demo không được nằm trong JavaScript).
VITE_DEMO_LOGIN=
# VITE_DEMO_PASSWORD=
