# =============================================================================
# WebGIS Dashboard - Local Environment Configuration
# Sao chép file này thành .env hoặc .env.local: cp .env.example .env
# =============================================================================

# Cổng khởi chạy Vite Dev Server
VITE_PORT=5173

# Địa chỉ API Gateway Nginx (hoặc Core API trực tiếp)
VITE_API_BASE_URL=http://localhost:8080

# Khóa Mapbox GL JS hiển thị bản đồ số 3D Terrain
VITE_MAPBOX_ACCESS_TOKEN=pk.placeholder_mapbox_token
