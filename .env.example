# =============================================================================
# GEOSENTRY (TERRAWATCH) - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env: cp .env.example .env
# =============================================================================

# 1. Cấu hình CSDL PostgreSQL 15 + PostGIS 3.3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=terrawatch
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/terrawatch
JDBC_DATABASE_URL=jdbc:postgresql://postgres:5432/terrawatch

# 2. Cấu hình Redis Event Bus & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_EVENT_CHANNEL=terrawatch:events

# 3. Bảo mật & Xác thực Core API (Spring Boot 3)
SERVER_PORT=3000
JWT_SECRET=terrawatch_super_secret_jwt_key_for_capstone_project_2026_se_defense
JWT_EXPIRATION_MS=86400000

# 4. Địa chỉ nội bộ các Microservices
CORE_API_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8001
GIS_SERVICE_URL=http://localhost:8002
WEBGIS_URL=http://localhost:5173
GATEWAY_URL=http://localhost:8080

# 5. Khóa dịch vụ bên ngoài & Phát cảnh báo khẩn cấp (External APIs & Broadcast)
MAPBOX_ACCESS_TOKEN=pk.placeholder_mapbox_token
SENTINEL_HUB_CLIENT_ID=placeholder_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=placeholder_sentinel_client_secret
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
FCM_SERVER_KEY=placeholder_fcm_key
SMS_PROVIDER=esms
SMS_API_KEY=placeholder_sms_key
SMS_SECRET_KEY=placeholder_sms_secret
SMS_BRANDNAME=TERRAWATCH
