# =============================================================================
# GEOSENTRY (TERRAWATCH) - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env: cp .env.example .env
# =============================================================================

# 1. Cấu hình CSDL PostgreSQL 15 + PostGIS 3.3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=terrawatch
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/terrawatch
JDBC_DATABASE_URL=jdbc:postgresql://postgres:5432/terrawatch

# 2. Cấu hình Redis Event Bus & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_EVENT_CHANNEL=terrawatch:events

# 3. Bảo mật & Xác thực Core API (Spring Boot 3)
SERVER_PORT=3000
JWT_SECRET=terrawatch_super_secret_jwt_key_for_capstone_project_2026_se_defense
JWT_EXPIRATION_MS=86400000

# 4. Địa chỉ nội bộ các Microservices
CORE_API_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8001
GIS_SERVICE_URL=http://localhost:8002
WEBGIS_URL=http://localhost:5173
GATEWAY_URL=http://localhost:8080

# 5. Khóa dịch vụ bên ngoài & Phát cảnh báo khẩn cấp (External APIs & Broadcast)
MAPBOX_ACCESS_TOKEN=pk.placeholder_mapbox_token
SENTINEL_HUB_CLIENT_ID=placeholder_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=placeholder_sentinel_client_secret
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
FCM_SERVER_KEY=placeholder_fcm_key
# Story 4.39: SMS Gateway (eSMS VN / Twilio) (leave blank to disable SMS; broadcasts still store)
SMS_PROVIDER=esms
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=Baotrixemay
ESMS_SANDBOX=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_HOTLINE=112

# 6. Scheduled rainfall estimates (Open-Meteo; research/demo does not require a key)
RAINFALL_AUTO_ENABLED=true
# Hourly weather refresh; backend enforces a minimum of 900 seconds.
RAINFALL_REFRESH_SECONDS=3600
# Experimental live GRU inference after a successful weather refresh.
LIVE_GRU_ENABLED=true
# Optional commercial subscription key; backend only, never VITE_ or frontend code.
OPEN_METEO_API_KEY=

# Forgot password by e-mail code (Story 4.21). Use a Gmail account with 2-Step Verification and create an
# 'App password' at https://myaccount.google.com/apppasswords (16 letters, no spaces). Never commit the real value.
MAIL_USERNAME=
MAIL_PASSWORD=
